[Unit]
Description=Weekly KDE Profile Backup
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/Belgeler/projects/kde-profile-backup/scripts/kde_backup_restore.py --full
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/Belgeler/projects/kde-profile-backup
# Note: Replace 'Belgeler/projects' with your actual path to this repo
StandardOutput=journal
StandardError=journal

# Add a small delay to ensure desktop is fully loaded
ExecStartPre=/bin/sleep 30

[Install]
WantedBy=default.target